# systemd EnvironmentFile, OUTSIDE app; placeholders intentionally fail S02.
# No shell sourcing, variable expansion or production values.
NOVALVION_ENV=sandbox
NODE_ENV=production
SANDBOX_ID=pricesmart-qa
SANDBOX_ROOT=/srv/novalvion-ps-sandbox
DB_HOST=127.0.0.1
DB_PORT=43306
DB_NAME=sandbox_pricesmart
DB_USER=sandbox_pricesmart
AUTH_SECRET=@AUTH_SECRET@
DB_PASSWORD=@DB_PASSWORD@
PORTAL_CREDENTIALS_KEY=@PORTAL_CREDENTIALS_KEY@
UPLOAD_DIR=/srv/novalvion-ps-sandbox/uploads
CB2_PUBLIC_ORIGIN=https://localhost:4316
EMPRESA_DOMINIOS='{"localhost":"kt-monaco"}'
NEXT_TELEMETRY_DISABLED=1
CB2_DOCUMENTOS_FASE2=0
FLOTA_PROPIEDAD_EXTERNA=0
PORT=3000
