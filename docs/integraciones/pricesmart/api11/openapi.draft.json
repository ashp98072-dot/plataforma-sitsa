            "type": "string",
            "enum": [
              "ORIGIN_REQUEST",
              "DUPLICATE"
            ]
          }
        }
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "externalOrderId",
          "provisionalStatus",
          "processingStatus",
          "version",
          "correlationId"
        ],
        "properties": {
          "externalOrderId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "provisionalStatus": {
            "type": "string",
            "const": "RECEIVED"
          },
          "processingStatus": {
            "type": "string",
            "const": "PENDING"
          },
          "version": {
            "type": "integer",
            "const": 1
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "OrderView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "externalOrderId",
          "provisionalStatus",
          "processingStatus",
          "version",
          "correlationId"
        ],
        "properties": {
          "externalOrderId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "provisionalStatus": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "REVIEW_REQUIRED",
              "CANCELLATION_REQUESTED",
              "CANCELLED"
            ]
          },
          "processingStatus": {
            "type": "string",
            "enum": [
              "PENDING",
              "PAUSED",
              "CANCELLED"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "provisionalStatus": {
                  "const": "RECEIVED"
                }
              }
            },
            "then": {
              "properties": {
                "processingStatus": {
                  "const": "PENDING"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "provisionalStatus": {
                  "const": "CANCELLED"
                }
              }
            },
            "then": {
              "properties": {
                "processingStatus": {
                  "const": "CANCELLED"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "provisionalStatus": {
                  "enum": [
                    "REVIEW_REQUIRED",
                    "CANCELLATION_REQUESTED"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "processingStatus": {
                  "const": "PAUSED"
                }
              }
            }
          }
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "correlationId"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_INPUT",
              "TOO_LARGE",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "METHOD_NOT_ALLOWED",
              "NOT_ACCEPTABLE",
              "UNSUPPORTED_FORMAT",
              "REQUEST_TIMEOUT",
              "LIMITED",
              "REPLAY_REJECTED",
              "CONFLICT",
              "UNAVAILABLE",
              "DISABLED"
            ]
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CancellationReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
