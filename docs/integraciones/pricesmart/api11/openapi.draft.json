            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "provisionalStatus": {
            "type": "string",
            "const": "CANCELLATION_REQUESTED"
          },
          "processingStatus": {
            "type": "string",
            "const": "PAUSED"
          },
          "version": {
            "type": "integer",
            "minimum": 2,
            "maximum": 9007199254740991
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "provisionalStatus": {
                  "const": "RECEIVED"
                }
              }
            },
            "then": {
              "properties": {
                "processingStatus": {
                  "const": "PENDING"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "provisionalStatus": {
                  "const": "CANCELLED"
                }
              }
            },
            "then": {
              "properties": {
                "processingStatus": {
                  "const": "CANCELLED"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "provisionalStatus": {
                  "enum": [
                    "REVIEW_REQUIRED",
                    "CANCELLATION_REQUESTED"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "processingStatus": {
                  "const": "PAUSED"
                }
              }
            }
          }
        ]
      }
