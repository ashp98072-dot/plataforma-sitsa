  "checks": [
    {
      "TABLE_NAME": "canecas_capas_costo",
      "CONSTRAINT_NAME": "chk_can_capa_cant",
      "CHECK_CLAUSE": "`cantidad_inicial` > 0 and `cantidad_disponible` >= 0 and `cantidad_disponible` <= `cantidad_inicial`"
    },
    {
      "TABLE_NAME": "canecas_capas_costo",
      "CONSTRAINT_NAME": "chk_can_capa_costo",
      "CHECK_CLAUSE": "`costo_unitario_centavos` is null or `costo_unitario_centavos` >= 0"
    },
    {
      "TABLE_NAME": "canecas_capas_costo",
      "CONSTRAINT_NAME": "chk_can_capa_fuente",
      "CHECK_CLAUSE": "(`recepcion_id` is not null) + (`valoracion_id` is not null) + (`redistribucion_id` is not null) = 1"
    },
    {
      "TABLE_NAME": "canecas_capas_costo",
      "CONSTRAINT_NAME": "chk_can_capa_moneda",
      "CHECK_CLAUSE": "`costo_unitario_centavos` is null or `moneda` is not null"
    },
    {
      "TABLE_NAME": "canecas_capas_costo",
      "CONSTRAINT_NAME": "chk_can_capa_orden",
      "CHECK_CLAUSE": "`orden_fifo` is null or `orden_fifo` > 0 and `redistribucion_id` is not null"
    },
    {
      "TABLE_NAME": "canecas_redistribuciones",
      "CONSTRAINT_NAME": "chk_can_redis_cantidades",
      "CHECK_CLAUSE": "`cantidad_origen` > 0 and `cantidad_resultante` > 0 and `diferencia` = `cantidad_resultante` - `cantidad_origen` and `costo_total_centavos` >= 0"
    },
    {
      "TABLE_NAME": "canecas_redistribuciones",
      "CONSTRAINT_NAME": "chk_can_redis_mov",
      "CHECK_CLAUSE": "`diferencia` = 0 = (`movimiento_id` is null)"
    },
    {
      "TABLE_NAME": "canecas_redistribuciones",
      "CONSTRAINT_NAME": "chk_can_redis_reverso",
      "CHECK_CLAUSE": "`reversado_por` is null and `reversado_en` is null and `motivo_reverso` is null and `movimiento_reverso_id` is null or `reversado_por` is not null and `reversado_en` is not null and `motivo_reverso` is not null and `movimiento_id` is null = (`movimiento_reverso_id` is null)"
    },
    {
      "TABLE_NAME": "canecas_redistribuciones_origen",
      "CONSTRAINT_NAME": "chk_can_redis_origen",
      "CHECK_CLAUSE": "`cantidad` > 0 and `costo_unitario_centavos` >= 0"
    }
  ],
  "triggers": [
    {
      "TRIGGER_NAME": "can_capa_costo_inmutable",
      "EVENT_OBJECT_TABLE": "canecas_capas_costo",
      "ACTION_TIMING": "BEFORE",
      "EVENT_MANIPULATION": "UPDATE",
      "ACTION_STATEMENT": "BEGIN\n  IF OLD.id <> NEW.id OR OLD.creado_en <> NEW.creado_en OR OLD.empresa_id <> NEW.empresa_id OR OLD.producto_id <> NEW.producto_id OR OLD.ubicacion_id <> NEW.ubicacion_id OR NOT (OLD.recepcion_id <=> NEW.recepcion_id) OR NOT (OLD.valoracion_id <=> NEW.valoracion_id) OR NOT (OLD.redistribucion_id <=> NEW.redistribucion_id) OR NOT (OLD.orden_fifo <=> NEW.orden_fifo) OR OLD.segmento <> NEW.segmento OR OLD.cantidad_inicial <> NEW.cantidad_inicial OR NOT (OLD.costo_unitario_centavos <=> NEW.costo_unitario_centavos) OR NOT (OLD.moneda <=> NEW.moneda) THEN\n    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Costo historico de capa inmutable';\n  END IF;\nEND"
    },
    {
      "TRIGGER_NAME": "trg_can_redis_bd",
      "EVENT_OBJECT_TABLE": "canecas_redistribuciones",
      "ACTION_TIMING": "BEFORE",
      "EVENT_MANIPULATION": "DELETE",
      "ACTION_STATEMENT": "BEGIN\n  SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'CANECAS_REDISTRIBUCION_NO_ELIMINABLE';\nEND"
    },
    {
      "TRIGGER_NAME": "trg_can_redis_bu",
      "EVENT_OBJECT_TABLE": "canecas_redistribuciones",
      "ACTION_TIMING": "BEFORE",
      "EVENT_MANIPULATION": "UPDATE",
      "ACTION_STATEMENT": "BEGIN\n  IF NOT (NEW.id <=> OLD.id)\n    OR NOT (NEW.empresa_id <=> OLD.empresa_id)\n    OR NOT (NEW.compra_id <=> OLD.compra_id)\n    OR NOT (NEW.producto_id <=> OLD.producto_id)\n    OR NOT (NEW.ubicacion_id <=> OLD.ubicacion_id)\n    OR NOT (NEW.cantidad_origen <=> OLD.cantidad_origen)\n    OR NOT (NEW.cantidad_resultante <=> OLD.cantidad_resultante)\n    OR NOT (NEW.diferencia <=> OLD.diferencia)\n    OR NOT (NEW.costo_total_centavos <=> OLD.costo_total_centavos)\n    OR NOT (NEW.moneda <=> OLD.moneda)\n    OR NOT (NEW.documento <=> OLD.documento)\n    OR NOT (NEW.motivo <=> OLD.motivo)\n    OR NOT (NEW.clave_operacion <=> OLD.clave_operacion)\n    OR NOT (NEW.movimiento_id <=> OLD.movimiento_id)\n    OR NOT (NEW.creado_por <=> OLD.creado_por)\n    OR NOT (NEW.creado_en <=> OLD.creado_en) THEN\n    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'CANECAS_REDISTRIBUCION_INMUTABLE';\n  END IF;\n  IF OLD.reversado_por IS NOT NULL THEN\n    IF NOT (NEW.reversado_por <=> OLD.reversado_por)\n      OR NOT (NEW.reversado_en <=> OLD.reversado_en)\n      OR NOT (NEW.motivo_reverso <=> OLD.motivo_reverso)\n      OR NOT (NEW.movimiento_reverso_id <=> OLD.movimiento_reverso_id) THEN\n      SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'CANECAS_REDISTRIBUCION_REVERSO_INMUTABLE';\n    END IF;\n  END IF;\nEND"
    },
    {
      "TRIGGER_NAME": "trg_can_redis_origen_bd",
      "EVENT_OBJECT_TABLE": "canecas_redistribuciones_origen",
      "ACTION_TIMING": "BEFORE",
      "EVENT_MANIPULATION": "DELETE",
      "ACTION_STATEMENT": "BEGIN\n  SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'CANECAS_REDISTRIBUCION_ORIGEN_NO_ELIMINABLE';\nEND"
    },
    {
      "TRIGGER_NAME": "trg_can_redis_origen_bu",
      "EVENT_OBJECT_TABLE": "canecas_redistribuciones_origen",
      "ACTION_TIMING": "BEFORE",
      "EVENT_MANIPULATION": "UPDATE",
      "ACTION_STATEMENT": "BEGIN\n  SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'CANECAS_REDISTRIBUCION_ORIGEN_INMUTABLE';\nEND"
    }
  ]
