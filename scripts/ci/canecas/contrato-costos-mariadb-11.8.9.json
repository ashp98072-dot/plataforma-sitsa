    {
      "CONSTRAINT_NAME": "chk_can_capa_cant",
      "CHECK_CLAUSE": "`cantidad_inicial` > 0 and `cantidad_disponible` >= 0 and `cantidad_disponible` <= `cantidad_inicial`"
    },
    {
      "CONSTRAINT_NAME": "chk_can_capa_costo",
      "CHECK_CLAUSE": "`costo_unitario_centavos` is null or `costo_unitario_centavos` >= 0"
    },
    {
      "CONSTRAINT_NAME": "chk_can_capa_fuente",
      "CHECK_CLAUSE": "`recepcion_id` is null <> (`valoracion_id` is null)"
    },
    {
      "CONSTRAINT_NAME": "chk_can_capa_moneda",
      "CHECK_CLAUSE": "`costo_unitario_centavos` is null or `moneda` is not null"
    },
    {
      "CONSTRAINT_NAME": "chk_can_compra_costos",
      "CHECK_CLAUSE": "(`precio_unitario_centavos` is null or `precio_unitario_centavos` >= 0) and (`gastos_centavos` is null or `gastos_centavos` >= 0) and (`precio_unitario_centavos` is null and `gastos_centavos` is null or `moneda` is not null)"
    },
    {
      "CONSTRAINT_NAME": "chk_can_gasto_estado",
      "CHECK_CLAUSE": "`estado` = 'PENDIENTE'"
    },
    {
      "CONSTRAINT_NAME": "chk_can_gasto_positivo",
      "CHECK_CLAUSE": "`importe_centavos` >= 0"
    },
    {
      "CONSTRAINT_NAME": "chk_can_precio_venta",
      "CHECK_CLAUSE": "`precio_venta_referencia_centavos` is null or `precio_venta_referencia_centavos` >= 0 and `precio_venta_referencia_moneda` is not null"
    },
    {
      "CONSTRAINT_NAME": "chk_can_val_cantidad",
      "CHECK_CLAUSE": "`cantidad` > 0"
    },
    {
      "CONSTRAINT_NAME": "chk_can_val_costo",
      "CHECK_CLAUSE": "`costo_unitario_centavos` is null or `costo_unitario_centavos` >= 0"
    }
