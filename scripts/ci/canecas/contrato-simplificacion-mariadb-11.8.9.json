  "checks": [
    {
      "TABLE_NAME": "canecas_productos",
      "CONSTRAINT_NAME": "chk_can_capacidad",
      "CHECK_CLAUSE": "`capacidad` > 0"
    },
    {
      "TABLE_NAME": "canecas_productos",
      "CONSTRAINT_NAME": "chk_can_precio_venta",
      "CHECK_CLAUSE": "`precio_venta_referencia_centavos` is null or `precio_venta_referencia_centavos` >= 0 and `precio_venta_referencia_moneda` is not null"
    },
    {
      "TABLE_NAME": "canecas_secuencias",
      "CONSTRAINT_NAME": "chk_can_secuencia",
      "CHECK_CLAUSE": "`ultimo` >= 0"
    },
    {
      "TABLE_NAME": "canecas_ventas",
      "CONSTRAINT_NAME": "chk_can_venta_direccion",
      "CHECK_CLAUSE": "`direccion_entrega` is null or char_length(trim(`direccion_entrega`)) > 0"
    },
    {
      "TABLE_NAME": "canecas_ventas",
      "CONSTRAINT_NAME": "chk_can_venta_estado",
      "CHECK_CLAUSE": "`estado` = 'ACTIVA' and `anulada_por` is null and `anulada_en` is null and `motivo_anulacion` is null or `estado` = 'ANULADA' and `anulada_por` is not null and `anulada_en` is not null and `motivo_anulacion` is not null"
    },
    {
      "TABLE_NAME": "canecas_ventas",
      "CONSTRAINT_NAME": "chk_can_venta_importes",
      "CHECK_CLAUSE": "`cantidad` > 0 and `precio_unitario_centavos` > 0 and `total_centavos` = cast(`precio_unitario_centavos` as decimal(38,0)) * `cantidad` and `costo_centavos` >= 0 and `moneda` = 'GTQ'"
    }
  ],
  "triggers": [
    {
      "TRIGGER_NAME": "trg_can_venta_bd",
      "EVENT_OBJECT_TABLE": "canecas_ventas",
      "ACTION_TIMING": "BEFORE",
      "EVENT_MANIPULATION": "DELETE",
      "ACTION_STATEMENT": "BEGIN\n  SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'CANECAS_VENTA_NO_ELIMINABLE';\nEND"
    },
    {
      "TRIGGER_NAME": "trg_can_venta_bu",
      "EVENT_OBJECT_TABLE": "canecas_ventas",
      "ACTION_TIMING": "BEFORE",
      "EVENT_MANIPULATION": "UPDATE",
      "ACTION_STATEMENT": "BEGIN\n  IF NOT (NEW.id <=> OLD.id)\n    OR NOT (NEW.empresa_id <=> OLD.empresa_id)\n    OR NOT (NEW.cliente_id <=> OLD.cliente_id)\n    OR NOT (NEW.producto_id <=> OLD.producto_id)\n    OR NOT (NEW.ubicacion_id <=> OLD.ubicacion_id)\n    OR NOT (NEW.direccion_entrega <=> OLD.direccion_entrega)\n    OR NOT (NEW.fecha_venta <=> OLD.fecha_venta)\n    OR NOT (NEW.documento <=> OLD.documento)\n    OR NOT (NEW.cantidad <=> OLD.cantidad)\n    OR NOT (NEW.precio_unitario_centavos <=> OLD.precio_unitario_centavos)\n    OR NOT (NEW.total_centavos <=> OLD.total_centavos)\n    OR NOT (NEW.costo_centavos <=> OLD.costo_centavos)\n    OR NOT (NEW.moneda <=> OLD.moneda)\n    OR NOT (NEW.salida_id <=> OLD.salida_id)\n    OR NOT (NEW.clave_operacion <=> OLD.clave_operacion)\n    OR NOT (NEW.creado_por <=> OLD.creado_por)\n    OR NOT (NEW.creado_en <=> OLD.creado_en) THEN\n    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'CANECAS_VENTA_INMUTABLE';\n  END IF;\n  IF OLD.estado = 'ANULADA' AND (NOT (NEW.estado <=> OLD.estado) OR NOT (NEW.anulada_por <=> OLD.anulada_por) OR NOT (NEW.anulada_en <=> OLD.anulada_en) OR NOT (NEW.motivo_anulacion <=> OLD.motivo_anulacion)) THEN\n    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'CANECAS_VENTA_ANULADA_INMUTABLE';\n  END IF;\nEND"
    }
  ]
}
