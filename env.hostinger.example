# Copia a .builds/config/.env en File Manager de Hostinger.
# Usa una BASE NUEVA (no la de asistencias).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=uXXXXXX_plataforma
DB_USER=uXXXXXX_plataforma
DB_PASSWORD=TU_PASSWORD_MYSQL
AUTH_SECRET=cambia-este-secreto-largo-aleatorio
# Clave exclusiva para cifrar contraseñas de portales de proveedores.
# No cambiarla después de guardar credenciales o no podrán descifrarse.
PORTAL_CREDENTIALS_KEY=cambia-esta-clave-independiente-de-al-menos-32-caracteres

# GASTOS-COMPROBANTE-404-1 — OPCIONAL pero recomendado: ruta ABSOLUTA fija
# para comprobantes/facturas/firmas/documentos subidos (evidencias,
# documentos de RRHH, firmas, etc.). Sin esta variable, la app detecta
# sola la carpeta ".builds/uploads" (persistente entre despliegues) según
# la ubicación real del proceso — ya corregido para ser robusto ante
# cualquier profundidad de carpeta que use Hostinger — pero fijarla aquí
# elimina cualquier dependencia de esa detección automática.
# UPLOAD_DIR=/home/uXXXXXX/.builds/uploads
